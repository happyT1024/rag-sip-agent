OPENROUTER_API_KEY=token

# Telegram bot (see _bmad-output/specs/spec-telegram-bot/bot-limits.md)
# TELEGRAM_BOT_TOKEN — токен от @BotFather, обязателен (формат <id>:<ключ>)
TELEGRAM_BOT_TOKEN=token
# AGENT_BACKEND — fake | openrouter
AGENT_BACKEND=fake
# SPEND_CAP_USD — суммарный лимит расходов бота, доллары США
SPEND_CAP_USD=0.50
# RATE_LIMIT_PER_MINUTE — вопросов на чат в минуту
RATE_LIMIT_PER_MINUTE=5
# MAX_QUESTION_CHARS — максимум символов в вопросе
MAX_QUESTION_CHARS=1000
# AGENT_TIMEOUT_SECONDS — ожидание ответа агента, секунды
AGENT_TIMEOUT_SECONDS=120
# AGENT_ERROR_FALLBACK_COST_USD — списание при ошибке агента, доллары США
AGENT_ERROR_FALLBACK_COST_USD=0.01
# AGENT_MODEL — модель OpenRouter для ответов (нужен AGENT_BACKEND=openrouter)
AGENT_MODEL=openai/gpt-4o-mini
# MILVUS_URI — адрес Milvus; *.db путь означает Milvus Lite (как в тестах)
MILVUS_URI=http://localhost:19530
# OPENROUTER_BUDGET_USD — жёсткий бюджет OpenRouter на процесс, доллары США
OPENROUTER_BUDGET_USD=1.50
